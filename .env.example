# Copiar para .env.local e preencher com os valores do projeto cloud.
# Estas variáveis configuram o cliente de autenticação do frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Tudo o que tiver o prefixo VITE_ é público no browser.
# Nunca colocar secret keys ou service_role em variáveis VITE_.
