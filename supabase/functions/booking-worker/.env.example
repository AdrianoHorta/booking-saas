# Copy to .env.worker.local (ignored). These are server secrets, never VITE_*.
# Calendar uses the shared GOOGLE_CALENDAR_* and CALENDAR_ENCRYPTION_KEY secrets.
# BOOKING_WORKER_SECRET is configured separately, with the same value in Vault.
# Do not overwrite the worker secret when configuring the email provider.
RESEND_API_KEY=replace-with-resend-key
BOOKING_EMAIL_FROM=Booking <reservas@your-verified-domain.example>
BOOKING_APP_ORIGIN=https://your-app.vercel.app
