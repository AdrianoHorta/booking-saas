{
  "name": "booking-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "tsc -p e2e/tsconfig.json && playwright test",
    "test:e2e:report": "playwright show-report",
    "preview": "vite preview",
    "db:login": "supabase login",
    "db:plan": "supabase db push --linked --dry-run --skip-vault",
    "db:push": "supabase db push --linked --skip-vault",
    "db:history": "supabase migration list --linked",
    "db:types": "supabase gen types --linked --lang typescript --schema public > src/lib/supabase/database.types.ts",
    "db:test:cloud": "node scripts/test-cloud-database.mjs",
    "db:test:concurrency": "node scripts/test-booking-concurrency.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "supabase": "2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
